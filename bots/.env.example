# Copier ce fichier en .env et le compléter. Le .env n'est jamais commité.

# --- Serveur Minecraft (les agents s'y connectent comme des joueurs normaux)
MC_HOST=localhost
MC_PORT=25565
MC_VERSION=1.20.4
MC_AUTH=offline

# --- Passerelle LiteLLM (seul point d'accès aux modèles)
LITELLM_BASE_URL=http://adresse-de-la-passerelle:4000
LITELLM_API_KEY=
LLM_MODEL=
# tools = function calling natif ; json = repli (réponse JSON dans le texte)
LLM_MODE=tools
LLM_TOOL_CHOICE=auto
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_MAX_FORMAT_RETRIES=2
# Limitation du débit (passerelle partagée entre tous les groupes)
LLM_MAX_CONCURRENT=1
LLM_MIN_INTERVAL_MS=1500
# Limite de tokens pour une partie (0 = pas de limite). Au-dela, plus d appel au modele, les bots gardent leurs reflexes.
LLM_BUDGET_TOKENS=0
# Reflexion du modele avant de repondre ("high" seulement, vide = sans) et pour quelles tetes (reflexion, parole, decision).
LLM_REASONING_EFFORT=
LLM_REASONING_POUR=reflexion

# --- Partie
# GAME_ID=partie-01
LOG_DIR=../data/parties
AGENTS_FILE=agents.json
VOTE_TRIGGER=\[DESIGNATION\]
VOTE_COMMAND=/designer {joueur} {nature}

# --- Comportement des agents
AGENT_TICK_MS=30000
AGENT_CHAT_DEBOUNCE_MS=1500
AGENT_ACTION_TIMEOUT_MS=60000
AGENT_MAX_EVENTS=15
AGENT_HUMANIZE=true
# true = les agents jouent même sans humain connecté (parties de test entre IA)
AGENT_SANS_HUMAIN=false
# Vue 3D de chaque bot dans un navigateur : http://<machine>:<port> (vide = pas de vue)
AGENT_VUE_PORT=
# Mission donnée au bot pour un test (vide = il joue librement)
AGENT_MISSION=
AGENT_JOIN_DELAY_MAX_MS=20000
